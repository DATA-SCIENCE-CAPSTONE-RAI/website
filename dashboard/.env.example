# The backend's results database (read-only). For mock data: `uv run raieval demo-db` in the backend.
SQLITE_PATH=../../backend/runs/demo.sqlite
# The backend's local API (`uv run raieval serve`), for the Evaluation page. Server-side only.
RAIEVAL_API_URL=http://127.0.0.1:8765
# Hosted demo (DEPLOY.md): READ_ONLY=1 shows results and options, runs nothing; SITE_PASSWORD asks every visitor for it.
# READ_ONLY=1
# SITE_USERNAME=
# SITE_PASSWORD=
NEXT_PUBLIC_GITHUB_URL=https://github.com
NEXT_PUBLIC_DOCS_URL=https://docs.github.com
